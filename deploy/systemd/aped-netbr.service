# aped-netbr.service — the host↔guest egress bridge for `ape sandbox` workspaces
# (PLAN-21). Pure HOST configuration: it creates one bridge that per-VM veths are
# enslaved to and applies a scoped nftables wall. No ape/aped code runs here, so
# it can be installed and verified before the egress code lands.
#
# Why a bridge at all: the CONNECT proxy runs in the de-privileged aped front and
# must be reachable from the guest at a stable IP:port. A link-local /24 keeps it
# inside the front's existing IPAddressAllow=169.254.0.0/16, so no inbound unit
# change is needed, and the guest needs NO DNS and NO default route — the proxy
# resolves each CONNECT host itself.
#
# Tunables live in /etc/aped/egress.env (generated by deploy/dev-host.sh):
#   APE_EGRESS_BRIDGE=apebr0
#   APE_EGRESS_HOST_CIDR=169.254.42.1/24
# The matching nftables ruleset is /etc/aped/nftables-egress.conf (also generated):
# it drops guest→host traffic except the proxy port range, and drops ALL
# forwarding across the bridge so a guest can never route to the LAN.
#
# NOTE: systemd has NO inline comments — a trailing "# ..." becomes part of the
# value. Every comment here is on its own line for that reason.
[Unit]
Description=aped-netbr — host<->guest sandbox egress bridge + nftables wall
Documentation=https://github.com/exoport/apex_process_ape/blob/main/docs/how-to/run-aped.md
After=network-pre.target
Before=aped.service aped-front.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/aped/egress.env
# "-" prefixes make the create steps idempotent: `ip link add` and `ip addr add`
# exit non-zero when the bridge/address already exist, which is the steady state
# on every re-run and after a manual `systemctl restart`.
ExecStart=-/usr/sbin/ip link add name ${APE_EGRESS_BRIDGE} type bridge
ExecStart=/usr/sbin/ip link set ${APE_EGRESS_BRIDGE} up
ExecStart=-/usr/sbin/ip addr add ${APE_EGRESS_HOST_CIDR} dev ${APE_EGRESS_BRIDGE}
# The host must never route between a guest and anything else; the guest's only
# permitted peer is the proxy socket on the bridge IP itself.
ExecStart=/usr/sbin/sysctl -q -w net.ipv4.conf.${APE_EGRESS_BRIDGE}.forwarding=0
ExecStart=/usr/sbin/nft -f /etc/aped/nftables-egress.conf
ExecStop=-/usr/sbin/nft delete table inet ape_egress
ExecStop=-/usr/sbin/ip link del ${APE_EGRESS_BRIDGE}

[Install]
WantedBy=multi-user.target
