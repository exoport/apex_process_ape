# Re-publish the operator's Claude credential for `ape sandbox` workspaces.
#
# This is a USER service, deliberately, and it is the one piece of credential sharing
# that cannot live in aped: a `claude /login` REPLACES the credential file, and only a
# process running as the operator can see their home to notice — aped runs as its own
# user with ProtectHome=yes. Without it, a host login reaches workspaces the next time
# any `ape sandbox` command runs (each one re-publishes); with it, no command is needed.
#
# Install:
#   install -D -m0644 deploy/user/ape-credentials-watch.service \
#     ~/.config/systemd/user/ape-credentials-watch.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now ape-credentials-watch
#
# To have it start at BOOT rather than at first login, enable lingering for your user —
# without this, a user manager only exists while you have a session:
#   sudo loginctl enable-linger $USER
#
# It needs no aped node, no running workspace, and no publication: with nothing published
# it simply idles, so it is safe to enable before ever running `credentials publish`.
[Unit]
Description=Re-publish the Claude credential for ape sandbox workspaces
Documentation=https://github.com/exoport/apex_process_ape/blob/main/docs/how-to/run-aped.md

[Service]
Type=simple
# %h is the operator's home; adjust if ape is installed elsewhere (e.g. /usr/local/bin).
ExecStart=%h/.local/bin/ape sandbox credentials watch
Restart=on-failure
RestartSec=5s
# It only ever touches its own credential + the publication.
NoNewPrivileges=yes

[Install]
WantedBy=default.target
